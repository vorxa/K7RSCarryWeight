# Copy a data tree only after every replaced file has a verified, unique backup.
foreach(required SOURCE DESTINATION BACKUP_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "deploy_data: ${required} is required")
    endif()
endforeach()
cmake_path(ABSOLUTE_PATH SOURCE NORMALIZE)
cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE)
cmake_path(ABSOLUTE_PATH BACKUP_ROOT NORMALIZE)
cmake_path(IS_PREFIX DESTINATION "${BACKUP_ROOT}" NORMALIZE backup_inside)
if(backup_inside)
    message(FATAL_ERROR "deploy_data: backup directory must be outside destination")
endif()
if(NOT IS_DIRECTORY "${SOURCE}")
    message(FATAL_ERROR "deploy_data: source directory does not exist: ${SOURCE}")
endif()
file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${SOURCE}" "${SOURCE}/*")
set(changed "")
set(replaced "")
foreach(relative IN LISTS files)
    if(EXISTS "${DESTINATION}/${relative}")
        if(IS_DIRECTORY "${DESTINATION}/${relative}")
            message(FATAL_ERROR "deploy_data: destination is a directory: ${relative}")
        endif()
        file(SHA256 "${SOURCE}/${relative}" source_hash)
        file(SHA256 "${DESTINATION}/${relative}" destination_hash)
        if(source_hash STREQUAL destination_hash)
            continue()
        endif()
        list(APPEND replaced "${relative}")
    endif()
    list(APPEND changed "${relative}")
endforeach()
if(replaced)
    string(TIMESTAMP stamp "%Y%m%d-%H%M%S" UTC)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(snapshot "${BACKUP_ROOT}/${stamp}-${nonce}")
    if(EXISTS "${snapshot}")
        message(FATAL_ERROR "deploy_data: backup already exists: ${snapshot}")
    endif()
    foreach(relative IN LISTS replaced)
        get_filename_component(parent "${snapshot}/${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY_FILE "${DESTINATION}/${relative}" "${snapshot}/${relative}" RESULT copied)
        if(NOT copied STREQUAL "0")
            message(FATAL_ERROR "deploy_data: backup failed: ${relative}: ${copied}")
        endif()
        file(SHA256 "${DESTINATION}/${relative}" original_hash)
        file(SHA256 "${snapshot}/${relative}" backup_hash)
        if(NOT original_hash STREQUAL backup_hash)
            message(FATAL_ERROR "deploy_data: backup verification failed: ${relative}")
        endif()
    endforeach()
    message(STATUS "deploy_data: verified backup: ${snapshot}")
endif()
# No destination is modified until all backups have passed verification.
foreach(relative IN LISTS changed)
    get_filename_component(parent "${DESTINATION}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${SOURCE}/${relative}" "${DESTINATION}/${relative}")
endforeach()
