if(NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "TEST_ROOT is required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${TEST_ROOT}/deploy-test-${nonce}")
file(MAKE_DIRECTORY "${root}/source/lang" "${root}/destination/lang")
file(WRITE "${root}/source/lang/russian.toml" "text = 'new'\n")
file(WRITE "${root}/destination/lang/russian.toml" "text = 'user variants'\n")
file(WRITE "${root}/destination/config.user.toml" "enabled = false\n")
function(run_deploy)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DSOURCE=${root}/source" "-DDESTINATION=${root}/destination"
        "-DBACKUP_ROOT=${root}/backups" -P "${CMAKE_CURRENT_LIST_DIR}/deploy_data.cmake"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "deploy test failed: ${result}")
    endif()
endfunction()
run_deploy()
file(GLOB_RECURSE backups "${root}/backups/*/lang/russian.toml")
list(LENGTH backups count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "expected one backup")
endif()
list(GET backups 0 backup)
file(READ "${backup}" saved)
file(READ "${root}/destination/lang/russian.toml" deployed)
file(READ "${root}/destination/config.user.toml" user)
if(NOT saved STREQUAL "text = 'user variants'\n" OR
   NOT deployed STREQUAL "text = 'new'\n" OR NOT user STREQUAL "enabled = false\n")
    message(FATAL_ERROR "backup/deployment contents differ")
endif()
run_deploy()
file(GLOB snapshots LIST_DIRECTORIES true "${root}/backups/*")
list(LENGTH snapshots count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "unchanged files must not create backups")
endif()
file(WRITE "${root}/source/lang/russian.toml" "text = 'next'\n")
run_deploy()
file(GLOB snapshots LIST_DIRECTORIES true "${root}/backups/*")
list(LENGTH snapshots count)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "backup snapshots must not be overwritten")
endif()
# Fail before touching destination when the backup root cannot be used.
file(WRITE "${root}/blocked" "not a directory")
file(WRITE "${root}/source/lang/russian.toml" "text = 'must not deploy'\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${root}/source"
    "-DDESTINATION=${root}/destination" "-DBACKUP_ROOT=${root}/blocked"
    -P "${CMAKE_CURRENT_LIST_DIR}/deploy_data.cmake" RESULT_VARIABLE failed
    OUTPUT_QUIET ERROR_QUIET)
file(READ "${root}/destination/lang/russian.toml" after_failure)
if(failed EQUAL 0 OR NOT after_failure STREQUAL "text = 'next'\n")
    message(FATAL_ERROR "backup failure must prevent replacement")
endif()
message(STATUS "deploy_data tests passed; fixtures retained at ${root}")
